{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": ["**/.env.*local"],
    "globalEnv": ["NODE_ENV"],
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**",
                ".next/**",
                "!.next/cache/**"
            ]
        },
        "lint": {
            "outputs": []
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "test": {
            "dependsOn": [
                "build"
            ],
            "outputs": [],
            "inputs": [
                "src/**/*.tsx",
                "src/**/*.ts",
                "test/**/*.ts",
                "test/**/*.tsx"
            ]
        },
        "e2e": {
            "dependsOn": [
                "build"
            ],
            "cache": false,
            "outputs": [
                "playwright-report/**",
                "test-results/**"
            ]
        },
        "docker": {
            "dependsOn": [
                "^docker"
            ],
            "outputs": []
        },
        "dockerDev": {
            "dependsOn": [
                "^dockerDev"
            ],
            "outputs": []
        },
        "clean": {
            "cache": true
        },
        "dockerReady": {
            "dependsOn": [
                "^dockerReady"
            ],
            "outputs": []
        },
        "localReady": {
            "dependsOn": [
                "^localReady"
            ],
            "outputs": []
        }
    }
}