{
  "name": "@ticket-system/client-web",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --port 4200",
    "build": "ng build",
    "build:dev": "ng build --configuration=dev",
    "watch": "ng build --watch --configuration development",
    "docker": "cd ../../../ && docker build -f apps/Client/Web/Dockerfile -t erosklein/ticket-system-client-web:latest --build-arg BUILD_CONFIG=production . && docker push erosklein/ticket-system-client-web:latest",
    "dockerDev": "cd ../../../ && docker buildx build --platform linux/amd64 --push --progress=plain -f apps/Client/Web/Dockerfile -t erosklein/ticket-system-client-web:dev --build-arg BUILD_CONFIG=dev .",
    "clean": "rm -rf node_modules dist package-lock.json",
    "dockerReady": "./docker/dockerReady.sh",
    "localReady": "./docker/localReady.sh"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/cdk": "^19.0.2",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/material": "^19.0.2",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@material/dialog": "^14.0.0",
    "fs": "^0.0.1-security",
    "keycloak-angular": "^19.0.2",
    "keycloak-js": "^26.0.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0",
    "typescript": "~5.7.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.9.1",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "5.7.2"
  }
}
