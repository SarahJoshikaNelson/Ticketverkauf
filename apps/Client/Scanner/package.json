{
  "name": "scanner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "run-script-os",
    "dev:win32": "copy \".env.public\" \".env\" && vite --port 3000",
    "dev:darwin:linux": "cp \".env.public\" \".env\" && vite --port 3000",
    "dev:local": "run-script-os",
    "dev:local:win32": "copy \".env.public\" \".env\" && vite --port 3000",
    "dev:local:darwin:linux": "cp \".env.public\" \".env\" && vite --port 3000",
    "dev:dev": "run-script-os",
    "dev:dev:win32": "copy \".env.public.dev\" \".env\" && vite --port 3000",
    "dev:dev:darwin:linux": "cp \".env.public.dev\" \".env\" && vite --port 3000",
    "dev:prod": "run-script-os",
    "dev:prod:win32": "copy \".env.public.prod\" \".env\" && vite --port 3000",
    "dev:prod:darwin:linux": "cp \".env.public.prod\" \".env\" && vite --port 3000",
    "build": "run-script-os",
    "build:win32": "copy \".env.public\" \".env\" && tsc -b && vite build",
    "build:darwin:linux": "cp \".env.public\" \".env\" && tsc -b && vite build",
    "build:local": "run-script-os",
    "build:local:win32": "copy \".env.public\" \".env\" && tsc -b && vite build",
    "build:local:darwin:linux": "cp \".env.public\" \".env\" && tsc -b && vite build",
    "build:dev": "run-script-os",
    "build:dev:win32": "copy \".env.public.dev\" \".env\" && tsc -b && vite build",
    "build:dev:darwin:linux": "cp \".env.public.dev\" \".env\" && tsc -b && vite build",
    "build:prod": "run-script-os",
    "build:prod:win32": "copy \".env.public.prod\" \".env\" && tsc -b && vite build",
    "build:prod:darwin:linux": "cp \".env.public.prod\" \".env\" && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "docker": "cd ../../../ && docker build -f apps/Client/Scanner/Dockerfile -t erosklein/ticket-system-scanner:latest --build-arg VITE_MODE=prod . && docker push erosklein/ticket-system-scanner:latest",
    "dockerDev": "cd ../../../ && docker buildx build --platform linux/amd64 --push --progress=plain -f apps/Client/Scanner/Dockerfile -t erosklein/ticket-system-scanner:dev --build-arg VITE_MODE=dev ."
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@react-keycloak/web": "^3.4.0",
    "@tailwindcss/vite": "^4.1.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "keycloak-js": "^26.1.4",
    "lucide-react": "^0.483.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-qr-barcode-scanner": "2.1.18",
    "react-router": "7.9.5",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jsdom": "^27.1.0",
    "run-script-os": "^1.1.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "4.0.8"
  }
}
